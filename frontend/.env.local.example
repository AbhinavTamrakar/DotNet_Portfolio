# Copy this file to .env.local and adjust values for local development.
# .env.local is ignored by Git. Never commit real secrets.

# ASP.NET Core API base URL (server-side use only; do not expose secrets).
API_BASE_URL=https://localhost:7162/api

# Public site origin (used for canonical URLs and metadata).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
